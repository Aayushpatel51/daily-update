# npm run setup generates a private .env with random local credentials.
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://daily:REPLACE@127.0.0.1:54329/daily_update
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DELIVERY_MODE=preview
# Only sandbox mode permits live Telegram, to exactly these private chat IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_ALLOWLIST=
EDITOR_CHAT_ID=
# No paid search or model adapters exist. Research is imported by the owner.
# Hosted owner-only pilot; leave defaults for local preview.
PILOT_MODE=false
EMAIL_MODE=capture
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
PILOT_EMAIL=
EMAIL_FROM=Daily Update <onboarding@resend.dev>
TELEGRAM_TRANSPORT=polling
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
